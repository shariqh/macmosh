#!/bin/bash
# macmosh-host: the script MacMosh keeps on a workhorse (a Mac you reach from another Mac).
# It starts the desk server, prints the status report, manages desks and installs the login agent.
# Plain bash 3.2 (what macOS ships at /bin/bash): no associative arrays, no mapfile, no ${var,,}.
set -u

MACMOSH_HOST_VERSION=0.2.0
MACMOSH_PROTOCOL=1
AGENT_LABEL=io.github.shariqh.macmosh.host

MACMOSH_HOME="${MACMOSH_HOME:-$HOME/.macmosh}"
MACMOSH_SOCKET="${MACMOSH_SOCKET:-macmosh}"
# Homebrew's folders go at the END of PATH, so a stand-in tool earlier on PATH wins in tests.
PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"
export MACMOSH_HOME MACMOSH_SOCKET PATH

TAB=$'\t'

# Every tmux call goes through this one function, so it always names the desk server's socket.
mm_tmux() { command tmux -L "$MACMOSH_SOCKET" "$@"; }

# ---------------------------------------------------------------- log

# One line per subcommand: an ISO 8601 time, the subcommand and the result.
# The log never makes a subcommand fail, and it is cut back when it grows past about 1 MB.
mm_log() {
    local log="$MACMOSH_HOME/host.log" size
    mkdir -p "$MACMOSH_HOME" 2>/dev/null || return 0
    if [ -f "$log" ]; then
        size=$(wc -c < "$log" 2>/dev/null | tr -d ' ')
        if [ "${size:-0}" -gt 1000000 ]; then
            tail -n 2000 "$log" > "$log.$$.tmp" 2>/dev/null && mv "$log.$$.tmp" "$log" 2>/dev/null
        fi
    fi
    printf '%s\t%s\t%s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$1" "$2" >> "$log" 2>/dev/null
    return 0
}

# ---------------------------------------------------------------- small helpers

# Tabs and newlines become spaces, so one value can never break the record around it.
mm_clean() { printf '%s' "$1" | tr '\t\n\r' '   '; }

mm_valid_desk_name() {
    case "$1" in
        '' | *[!A-Za-z0-9_-]*) return 1 ;;
    esac
    [ "${#1}" -le 64 ]
}

mm_server_up() { mm_tmux list-sessions >/dev/null 2>&1; }

# The user logged in at the screen, or nothing.
mm_console_user() {
    local who
    who=$(stat -f %Su /dev/console 2>/dev/null)
    case "$who" in
        root | loginwindow | _mbsetupuser) who="" ;;
    esac
    printf '%s' "$who"
}

# ---------------------------------------------------------------- start

# The file tmux itself would read: ~/.tmux.conf, otherwise the XDG one.
mm_user_tmux_conf() {
    if [ -f "$HOME/.tmux.conf" ]; then
        printf '%s' "$HOME/.tmux.conf"
    else
        printf '%s' "${XDG_CONFIG_HOME:-$HOME/.config}/tmux/tmux.conf"
    fi
}

mm_write_tmux_conf() {
    mkdir -p "$MACMOSH_HOME" || return 1
    {
        echo '# MacMosh defaults. Your own tmux settings are loaded next, so your settings win.'
        echo 'set -g mouse on'
        echo 'set -g history-limit 50000'
        echo "source-file -q \"$(mm_user_tmux_conf)\""
        echo 'set -s exit-empty off'
    } > "$MACMOSH_HOME/tmux.conf"
}

cmd_start() {
    if mm_server_up; then
        mm_log start "already up"
        return 0
    fi
    if ! mm_write_tmux_conf; then
        mm_log start "failed: cannot write tmux.conf"
        echo "macmosh-host: cannot write $MACMOSH_HOME/tmux.conf" >&2
        return 5
    fi
    mm_tmux -f "$MACMOSH_HOME/tmux.conf" start-server >/dev/null 2>&1
    if mm_server_up; then
        mm_reopen_desks
        mm_log start "started"
        return 0
    fi
    mm_log start "failed: server did not start"
    echo "macmosh-host: the desk server did not start" >&2
    return 5
}

# ---------------------------------------------------------------- desks

DESKS_FILE_NAME=desks.tsv

mm_desks_file() { printf '%s' "$MACMOSH_HOME/$DESKS_FILE_NAME"; }

# A leading ~ (alone or before a slash) means the home folder. Anything else is left as it is.
mm_expand_tilde() {
    local tilde='~'
    case "$1" in
        "$tilde") printf '%s' "$HOME" ;;
        "$tilde"/*) printf '%s' "$HOME/${1#"$tilde"/}" ;;
        *) printf '%s' "$1" ;;
    esac
}

# True when the text has a tab or a newline in it, which would break a line of desks.tsv.
mm_has_tab_or_newline() {
    case "$1" in
        *"$TAB"* | *$'\n'*) return 0 ;;
    esac
    return 1
}

# The line of desks.tsv for one desk, or nothing.
mm_def_line() {
    local file
    file=$(mm_desks_file)
    [ -f "$file" ] || return 0
    awk -F '\t' -v n="$1" '$1 == n { print; exit }' "$file"
}

mm_session_exists() { mm_tmux has-session -t "=$1" >/dev/null 2>&1; }

# This script's own full path, so a desk can run it again later.
mm_self_path() {
    local p="$0"
    case "$p" in
        */*) ;;
        *) p=$(command -v -- "$p" 2>/dev/null || printf '%s' "$p") ;;
    esac
    case "$p" in
        /*) ;;
        *) p="$PWD/${p#./}" ;;
    esac
    printf '%s' "$p"
}

# Text quoted for a shell: inside single quotes, with each ' written as '\''.
mm_shell_quote() {
    local text="$1" quote="'" out=""
    while :; do
        case "$text" in
            *"$quote"*)
                out="$out${text%%"$quote"*}'\''"
                text="${text#*"$quote"}"
                ;;
            *) break ;;
        esac
    done
    printf "'%s'" "$out$text"
}

# Creates the session for a desk: in its folder, then types the startup command exactly as written.
# For a desk that keeps its command running, it types "<this script> keep <desk>" instead, and that
# runs the command again whenever it ends.
# The keys wait in the terminal's input queue, so a shell that is slow to start still receives them.
mm_create_session() {
    # $1 name, $2 folder, $3 startup command (may be empty), $4 keep: 1 or 0 (optional)
    local folder="$2" typed="$3"
    if [ ! -d "$folder" ]; then
        mm_log "create-desk" "$1: folder is gone, using the home folder"
        folder="$HOME"
    fi
    if [ "${4:-0}" = 1 ] && [ -n "$typed" ]; then
        typed="$(mm_shell_quote "$(mm_self_path)") keep $1"
    fi
    mm_tmux new-session -d -s "$1" -c "$folder" >/dev/null 2>&1 || return 1
    if [ -n "$typed" ]; then
        mm_tmux send-keys -t "=$1:" -l -- "$typed" || return 1
        mm_tmux send-keys -t "=$1:" Enter || return 1
    fi
    return 0
}

# Recreates the desks marked reopen. Called by start, only when it has just started the server.
mm_reopen_desks() {
    local file name reopen keep folder command line
    file=$(mm_desks_file)
    [ -f "$file" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        IFS="$TAB" read -r name reopen keep folder command <<EOF
$line
EOF
        mm_valid_desk_name "$name" || continue
        [ "$reopen" = 1 ] || continue
        mm_session_exists "$name" && continue
        mm_create_session "$name" "$folder" "$command" "$keep" || mm_log start "could not reopen $name"
    done < "$file"
    return 0
}

# --- The lock around desks.tsv: a folder made with mkdir. One writer at a time. A lock folder older
# than 30 seconds belongs to a writer that died, so it is removed.

MM_LOCK_HELD=0

mm_unlock() {
    if [ "$MM_LOCK_HELD" = 1 ]; then
        MM_LOCK_HELD=0
        rmdir "$MACMOSH_HOME/lock" 2>/dev/null
    fi
    return 0
}

# Takes the lock, waiting up to 5 seconds. Releases it on every way out (the trap), including
# an error part-way and a signal.
mm_lock() {
    local lock="$MACMOSH_HOME/lock" tries=0 mtime now
    mkdir -p "$MACMOSH_HOME" || return 1
    while ! mkdir "$lock" 2>/dev/null; do
        mtime=$(/usr/bin/stat -f %m "$lock" 2>/dev/null)
        case "$mtime" in
            '' | *[!0-9]*) mtime="" ;;
        esac
        now=$(date +%s)
        if [ -n "$mtime" ] && [ $((now - mtime)) -gt 30 ] && rmdir "$lock" 2>/dev/null; then
            continue
        fi
        tries=$((tries + 1))
        [ "$tries" -lt 50 ] || return 1
        sleep 0.1
    done
    MM_LOCK_HELD=1
    trap mm_unlock EXIT
    trap 'exit 130' INT HUP
    trap 'exit 143' TERM
    return 0
}

mm_release_lock() {
    mm_unlock
    trap - EXIT INT HUP TERM
}

# If the desk server is down: with nobody logged in at the screen, exit 3. Otherwise ask macOS to
# run the login agent, wait up to 5 seconds, and exit 5 if the server is still down.
# This is the only way these subcommands get a server. They never start one themselves, because a
# tmux server started from an ssh login can't read the keychain.
mm_require_server() {
    # $1 the subcommand, for the log
    local who n=0
    if mm_server_up; then return 0; fi
    who=$(mm_console_user)
    if [ -z "$who" ]; then
        echo "Nobody is logged in at this Mac's screen, so desks can't start. Log in first." >&2
        mm_log "$1" "nobody logged in"
        exit 3
    fi
    launchctl kickstart "gui/$(id -u)/$AGENT_LABEL" >/dev/null 2>&1
    while [ "$n" -lt 10 ]; do
        if mm_server_up; then return 0; fi
        sleep 0.5
        n=$((n + 1))
    done
    if mm_server_up; then return 0; fi
    echo "The desk server didn't start." >&2
    mm_log "$1" "server did not start"
    exit 5
}

# A usage error: a message, a log line and exit 2.
mm_usage_error() {
    # $1 subcommand, $2 message
    echo "macmosh-host: $2" >&2
    mm_log "$1" "usage error"
    exit 2
}

cmd_desk_new() {
    local name="" folder="" reopen=0 keep=0 command="" npos=0 file tmp
    while [ $# -gt 0 ]; do
        case "$1" in
            --reopen) reopen=1 ;;
            --keep) keep=1 ;;
            --command)
                [ $# -ge 2 ] || mm_usage_error desk-new "--command needs a value"
                command="$2"
                shift
                ;;
            --*) mm_usage_error desk-new "unknown option $1" ;;
            *)
                npos=$((npos + 1))
                case "$npos" in
                    1) name="$1" ;;
                    2) folder="$1" ;;
                    *) mm_usage_error desk-new "too many arguments" ;;
                esac
                ;;
        esac
        shift
    done
    [ "$npos" -eq 2 ] || mm_usage_error desk-new "usage: desk-new <name> <folder> [--reopen] [--keep] [--command <text>]"

    if ! mm_valid_desk_name "$name"; then
        echo "macmosh-host: a desk name uses letters, digits, - and _ only, up to 64 characters" >&2
        mm_log desk-new "refused: bad name"
        return 6
    fi
    # Check before expanding: $(...) drops a new line at the end of the text.
    if mm_has_tab_or_newline "$folder" || mm_has_tab_or_newline "$command"; then
        echo "macmosh-host: a folder or command can't contain a tab or a new line" >&2
        mm_log desk-new "refused: tab or newline"
        return 6
    fi
    if [ "$keep" = 1 ] && [ -z "$command" ]; then
        echo "macmosh-host: there is nothing to keep running: --keep needs a --command" >&2
        mm_log desk-new "refused: keep without a command"
        return 6
    fi
    folder=$(mm_expand_tilde "$folder")
    case "$folder" in
        /*) ;;
        *)
            echo "macmosh-host: the folder must be a full path or start with ~" >&2
            mm_log desk-new "refused: folder is not a full path"
            return 6
            ;;
    esac
    if [ ! -d "$folder" ]; then
        echo "macmosh-host: no such folder: $folder" >&2
        mm_log desk-new "refused: no such folder"
        return 6
    fi

    mm_require_server desk-new

    if ! mm_lock; then
        echo "macmosh-host: could not lock the desk list" >&2
        mm_log desk-new "failed: lock"
        return 1
    fi
    if [ -n "$(mm_def_line "$name")" ] || mm_session_exists "$name"; then
        mm_release_lock
        echo "macmosh-host: the desk $name already exists" >&2
        mm_log desk-new "refused: $name already exists"
        return 7
    fi
    if ! mm_create_session "$name" "$folder" "$command" "$keep"; then
        mm_tmux kill-session -t "=$name" >/dev/null 2>&1
        mm_release_lock
        echo "macmosh-host: could not create the desk" >&2
        mm_log desk-new "failed: $name could not be created"
        return 1
    fi
    file=$(mm_desks_file)
    tmp="$MACMOSH_HOME/$DESKS_FILE_NAME.$$.tmp"
    if ! {
        if [ -f "$file" ]; then cat "$file"; fi
        printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$reopen" "$keep" "$folder" "$command"
    } > "$tmp" || ! mv "$tmp" "$file"; then
        rm -f "$tmp"
        mm_tmux kill-session -t "=$name" >/dev/null 2>&1
        mm_release_lock
        echo "macmosh-host: could not write the desk list" >&2
        mm_log desk-new "failed: $name could not be saved"
        return 1
    fi
    mm_release_lock
    mm_log desk-new "created $name"
    return 0
}

cmd_desk_remove() {
    local name="" kill=0 npos=0 had_def=0 had_session=0 file tmp
    while [ $# -gt 0 ]; do
        case "$1" in
            --kill) kill=1 ;;
            --*) mm_usage_error desk-remove "unknown option $1" ;;
            *)
                npos=$((npos + 1))
                [ "$npos" -le 1 ] || mm_usage_error desk-remove "too many arguments"
                name="$1"
                ;;
        esac
        shift
    done
    [ "$npos" -eq 1 ] || mm_usage_error desk-remove "usage: desk-remove <name> [--kill]"

    if ! mm_valid_desk_name "$name"; then
        echo "macmosh-host: no such desk: $name" >&2
        mm_log desk-remove "no such desk"
        return 4
    fi
    # No mm_require_server here: removing a desk never needs a server, and must never start one.
    # has-session and kill-session only talk to a server that is already running.
    if ! mm_lock; then
        echo "macmosh-host: could not lock the desk list" >&2
        mm_log desk-remove "failed: lock"
        return 1
    fi
    if [ -n "$(mm_def_line "$name")" ]; then had_def=1; fi
    if mm_session_exists "$name"; then had_session=1; fi
    if [ "$had_def" = 0 ] && { [ "$kill" = 0 ] || [ "$had_session" = 0 ]; }; then
        mm_release_lock
        echo "macmosh-host: no such desk: $name" >&2
        mm_log desk-remove "no such desk: $name"
        return 4
    fi
    if [ "$had_def" = 1 ]; then
        file=$(mm_desks_file)
        tmp="$MACMOSH_HOME/$DESKS_FILE_NAME.$$.tmp"
        if ! awk -F '\t' -v n="$name" '$1 != n' "$file" > "$tmp" || ! mv "$tmp" "$file"; then
            rm -f "$tmp"
            mm_release_lock
            echo "macmosh-host: could not write the desk list" >&2
            mm_log desk-remove "failed: $name could not be saved"
            return 1
        fi
    fi
    mm_release_lock
    if [ "$kill" = 1 ] && [ "$had_session" = 1 ]; then
        mm_tmux kill-session -t "=$name" >/dev/null 2>&1
    fi
    mm_log desk-remove "removed $name"
    return 0
}

cmd_window_new() {
    local name
    [ $# -eq 1 ] || mm_usage_error window-new "usage: window-new <desk>"
    name="$1"
    if ! mm_valid_desk_name "$name"; then
        echo "macmosh-host: no such desk: $name" >&2
        mm_log window-new "no such desk"
        return 4
    fi
    mm_require_server window-new
    if ! mm_session_exists "$name"; then
        echo "macmosh-host: the desk $name isn't open" >&2
        mm_log window-new "no such desk: $name"
        return 4
    fi
    if ! mm_tmux new-window -t "=$name:" >/dev/null 2>&1; then
        echo "macmosh-host: could not add a window" >&2
        mm_log window-new "failed: $name"
        return 1
    fi
    mm_log window-new "added a window to $name"
    return 0
}

cmd_attach() {
    local name="" cc=0 dry=0 npos=0 line reopen keep folder command
    while [ $# -gt 0 ]; do
        case "$1" in
            --cc) cc=1 ;;
            --dry-run) dry=1 ;;
            --*) mm_usage_error attach "unknown option $1" ;;
            *)
                npos=$((npos + 1))
                [ "$npos" -le 1 ] || mm_usage_error attach "too many arguments"
                name="$1"
                ;;
        esac
        shift
    done
    [ "$npos" -eq 1 ] || mm_usage_error attach "usage: attach [--cc] [--dry-run] <desk>"

    if ! mm_valid_desk_name "$name"; then
        echo "macmosh-host: no such desk: $name" >&2
        mm_log attach "no such desk"
        return 4
    fi
    mm_require_server attach

    if ! mm_session_exists "$name"; then
        line=$(mm_def_line "$name")
        if [ -z "$line" ]; then
            echo "macmosh-host: no such desk: $name" >&2
            mm_log attach "no such desk: $name"
            return 4
        fi
        # shellcheck disable=SC2034  # reopen is read only to get to the folder and the command
        IFS="$TAB" read -r name reopen keep folder command <<EOF
$line
EOF
        if ! mm_create_session "$name" "$folder" "$command" "$keep"; then
            echo "macmosh-host: could not open the desk $name" >&2
            mm_log attach "failed: $name could not be created"
            return 1
        fi
    fi

    if [ "$dry" = 1 ]; then
        echo ok
        mm_log attach "dry run $name"
        return 0
    fi
    mm_log attach "$name"
    # The terminal may itself be inside another tmux; the desk server is a separate one.
    unset TMUX
    if [ "$cc" = 1 ]; then
        exec tmux -L "$MACMOSH_SOCKET" -CC attach-session -t "=$name"
    fi
    exec tmux -L "$MACMOSH_SOCKET" attach-session -t "=$name"
}

# Runs the desk's startup command, and again each time it ends. It runs inside the desk's own shell
# (the desk types "<this script> keep <desk>"), so it reads the definition and starts nothing else:
# it never needs the desk server and never starts one.
# The pause starts at MACMOSH_KEEP_PAUSE seconds (default 5) and doubles, up to 60, while the command
# keeps ending within 10 seconds. A run of a minute or more sets it back to the start. A run in
# between leaves it as it is.
cmd_keep() {
    local name line reopen keep folder command start pause next began took code stopped=0
    [ $# -eq 1 ] || mm_usage_error keep "usage: keep <desk>"
    name="$1"
    line=""
    if mm_valid_desk_name "$name"; then
        line=$(mm_def_line "$name")
    fi
    if [ -z "$line" ]; then
        echo "macmosh-host: no such desk: $name" >&2
        mm_log keep "no such desk: $name"
        return 4
    fi
    # shellcheck disable=SC2034  # reopen and keep are read only to get to the folder and the command
    IFS="$TAB" read -r name reopen keep folder command <<EOF
$line
EOF
    if [ -z "$command" ]; then
        echo "There is nothing to keep running in the desk $name: it has no startup command."
        mm_log keep "$name: no command"
        return 0
    fi
    start="${MACMOSH_KEEP_PAUSE:-5}"
    case "$start" in
        '' | *[!0-9]*) start=5 ;;
    esac
    [ "$start" -ge 1 ] || start=5
    if [ -d "$folder" ]; then cd "$folder" || true; fi
    mm_log keep "$name: started"

    pause="$start"
    while :; do
        began=$(date +%s)
        # Ctrl-C goes to the command. This script only has to live through it.
        trap ':' INT
        "${SHELL:-/bin/zsh}" -lc "$command"
        code=$?
        trap - INT
        took=$(($(date +%s) - began))

        printf '%s ended (exit %s). Starting it again in %s seconds. Press Ctrl-C to stop.\n' "$command" "$code" "$pause"
        stopped=0
        trap 'stopped=1' INT
        sleep "$pause"
        trap - INT
        if [ "$stopped" = 1 ]; then
            echo
            mm_log keep "$name: stopped"
            return 0
        fi

        if [ "$took" -lt 10 ]; then
            next=$((pause * 2))
            [ "$next" -le 60 ] || next=60
            [ "$next" -ge "$pause" ] || next="$pause"
            pause="$next"
        elif [ "$took" -ge 60 ]; then
            pause="$start"
        fi
    done
}

cmd_folders() {
    local folder entry name
    [ $# -eq 1 ] || mm_usage_error folders "usage: folders <folder>"
    folder=$(mm_expand_tilde "$1")
    if [ -z "$folder" ] || [ ! -d "$folder" ]; then
        echo "macmosh-host: no such folder: $1" >&2
        mm_log folders "refused: no such folder"
        return 6
    fi
    # The glob skips hidden folders. A name with a new line in it would break the one-per-line list.
    for entry in "${folder%/}"/*/; do
        [ -d "$entry" ] || continue
        name="${entry%/}"
        name="${name##*/}"
        case "$name" in
            *$'\n'*) continue ;;
        esac
        printf '%s\n' "$name"
    done | LC_ALL=C sort
    mm_log folders "ok"
    return 0
}

# ---------------------------------------------------------------- login agent, restart, removal

# Text safe to put inside a plist <string>.
mm_xml_escape() {
    printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

cmd_install_agent() {
    local script agent_dir plist tmp uid status=0
    script="$MACMOSH_HOME/macmosh-host"
    # The path goes inside double quotes in a zsh command line: refuse what would break out of them.
    case "$script" in
        *'"'* | *'$'* | *'`'* | *\\*)
            echo "macmosh-host: the script's path has a character the login agent can't carry" >&2
            mm_log install-agent "refused: odd path"
            return 1
            ;;
    esac
    uid=$(id -u)
    agent_dir="$HOME/Library/LaunchAgents"
    plist="$agent_dir/$AGENT_LABEL.plist"
    tmp="$plist.$$.tmp"
    if ! mkdir -p "$agent_dir"; then
        echo "macmosh-host: cannot create $agent_dir" >&2
        mm_log install-agent "failed: no folder"
        return 1
    fi
    if ! {
        cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$AGENT_LABEL</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>exec "$(mm_xml_escape "$script")" start</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
</dict>
</plist>
EOF
    } > "$tmp" || ! mv "$tmp" "$plist"; then
        rm -f "$tmp"
        echo "macmosh-host: cannot write $plist" >&2
        mm_log install-agent "failed: cannot write"
        return 1
    fi
    # Unload an older copy first; it is fine if there is none.
    launchctl bootout "gui/$uid/$AGENT_LABEL" >/dev/null 2>&1
    launchctl bootstrap "gui/$uid" "$plist" || status=$?
    mm_log install-agent "exit $status"
    return "$status"
}

cmd_restart_server() {
    local yes=0 arg n=0
    for arg in "$@"; do
        case "$arg" in
            --yes) yes=1 ;;
            *) mm_usage_error restart-server "usage: restart-server --yes" ;;
        esac
    done
    [ "$yes" = 1 ] || mm_usage_error restart-server "restart-server closes every desk: add --yes to confirm"

    # Check first: with nobody at the screen the server could not come back, so close nothing.
    if [ -z "$(mm_console_user)" ]; then
        echo "Nobody is logged in at this Mac's screen, so desks can't start. Log in first." >&2
        mm_log restart-server "nobody logged in"
        return 3
    fi
    if mm_server_up; then
        mm_tmux kill-server >/dev/null 2>&1
        while mm_server_up && [ "$n" -lt 20 ]; do
            sleep 0.25
            n=$((n + 1))
        done
        if mm_server_up; then
            echo "The desk server didn't stop." >&2
            mm_log restart-server "server did not stop"
            return 5
        fi
    fi
    mm_require_server restart-server
    mm_log restart-server "ok"
    return 0
}

# Removes every line of authorized_keys that has the key as a whole field. The file is rewritten
# through a temporary file in its own folder and mv, keeps its mode, and is left alone when no
# line matches or when anything fails.
mm_remove_authorized_key() {
    local key="$1" file="$HOME/.ssh/authorized_keys" dir tmp mode removed
    [ -f "$file" ] || return 0
    dir=$(dirname "$file")
    tmp=$(mktemp "$dir/authorized_keys.XXXXXX") || return 1
    removed=$(LC_ALL=C awk -v key="$key" -v out="$tmp" '
        { hit = 0; for (i = 1; i <= NF; i++) if ($i == key) hit = 1 }
        hit { n++; next }
        { print > out }
        END { close(out); print n + 0 }
    ' "$file") || {
        rm -f "$tmp"
        return 1
    }
    if [ "$removed" = 0 ]; then
        rm -f "$tmp"
        return 0
    fi
    mode=$(/usr/bin/stat -f %Lp "$file" 2>/dev/null)
    case "$mode" in
        '' | *[!0-7]*) mode=600 ;;
    esac
    if ! chmod "$mode" "$tmp" || ! mv "$tmp" "$file"; then
        rm -f "$tmp"
        return 1
    fi
    return 0
}

cmd_uninstall() {
    local key="" have_key=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --key)
                [ $# -ge 2 ] || mm_usage_error uninstall "--key needs a value"
                key="$2"
                have_key=1
                shift
                ;;
            *) mm_usage_error uninstall "usage: uninstall --key <base64 key>" ;;
        esac
        shift
    done
    if [ "$have_key" = 0 ] || [ "${#key}" -lt 60 ]; then
        echo "macmosh-host: uninstall needs --key with MacMosh's whole public key (at least 60 characters)" >&2
        return 2
    fi
    case "$key" in
        *[!A-Za-z0-9+/=]*)
            echo "macmosh-host: the key isn't base64" >&2
            return 2
            ;;
    esac
    # Never delete a folder that could hold more than MacMosh's own files.
    case "$MACMOSH_HOME" in
        '' | / | "$HOME" | "$HOME/")
            echo "macmosh-host: refusing to remove $MACMOSH_HOME" >&2
            return 1
            ;;
    esac

    # The key first: if that fails, nothing else has been touched.
    if ! mm_remove_authorized_key "$key"; then
        echo "macmosh-host: could not update ~/.ssh/authorized_keys; nothing was removed" >&2
        return 1
    fi
    launchctl bootout "gui/$(id -u)/$AGENT_LABEL" >/dev/null 2>&1
    rm -f "$HOME/Library/LaunchAgents/$AGENT_LABEL.plist"
    # The desk server and open desks keep running. The log lives in the folder being emptied,
    # so this subcommand logs nothing: a log line would bring the folder back.
    # Remove only the names MacMosh makes there; a folder named by an environment variable
    # may hold other things.
    rm -f "$MACMOSH_HOME/macmosh-host" "$MACMOSH_HOME/macmosh-host.new" \
        "$MACMOSH_HOME/tmux.conf" "$MACMOSH_HOME/$DESKS_FILE_NAME" "$MACMOSH_HOME/host.log" \
        "$MACMOSH_HOME/$DESKS_FILE_NAME".*.tmp "$MACMOSH_HOME/host.log".*.tmp
    rmdir "$MACMOSH_HOME/lock" 2>/dev/null
    if [ -e "$MACMOSH_HOME" ] && ! rmdir "$MACMOSH_HOME" 2>/dev/null; then
        echo "macmosh-host: kept $MACMOSH_HOME because it holds files MacMosh didn't put there" >&2
    fi
    return 0
}

# ---------------------------------------------------------------- status

# A value from the "AC Power:" section of `pmset -g custom`: the first whole number after the name.
mm_power_value() {
    # $1 setting name, $2 the pmset text
    local v
    v=$(printf '%s\n' "$2" | awk -v key="$1" '
        /^AC Power:/ { ac = 1; next }
        /^[^ \t]/ { ac = 0 }
        ac && $1 == key {
            for (i = 2; i <= NF; i++) if ($i ~ /^[0-9]+$/) { print $i; exit }
        }')
    if [ -n "$v" ]; then printf '%s' "$v"; else printf '%s' "-"; fi
}

# 255.255.255.0 -> 24. Prints nothing for anything that is not a dotted mask.
mm_mask_to_prefix() {
    local mask="$1" a b c d bits=0 octet
    case "$mask" in
        *[!0-9.]* | '') return 0 ;;
    esac
    IFS=. read -r a b c d <<EOF
$mask
EOF
    for octet in "$a" "$b" "$c" "$d"; do
        case "$octet" in
            '' | *[!0-9]*) return 0 ;;
        esac
        [ "$octet" -le 255 ] || return 0
        while [ "$octet" -gt 0 ]; do
            bits=$((bits + (octet & 1)))
            octet=$((octet >> 1))
        done
    done
    printf '%s' "$bits"
}

# A hex mask such as 0xffffff00 -> 24.
mm_hexmask_to_prefix() {
    local hex="${1#0x}" value bits=0
    case "$hex" in
        '' | *[!0-9a-fA-F]*) return 0 ;;
    esac
    value=$((16#$hex))
    while [ "$value" -gt 0 ]; do
        bits=$((bits + (value & 1)))
        value=$((value >> 1))
    done
    printf '%s' "$bits"
}

# True for 100.64.0.0/10, the range Tailscale uses.
mm_is_tailscale_address() {
    local a b rest
    IFS=. read -r a b rest <<EOF
$1
EOF
    [ "$a" = 100 ] || return 1
    case "$b" in
        '' | *[!0-9]*) return 1 ;;
    esac
    [ "$b" -ge 64 ] && [ "$b" -le 127 ]
}

mm_home_record() {
    local iface addr="" n mask prefix="" localname="" line

    iface=$(route -n get default 2>/dev/null | awk '/interface:/ { print $2; exit }')
    if [ -n "$iface" ]; then
        addr=$(ipconfig getifaddr "$iface" 2>/dev/null)
    fi
    # A tunnel (or an address in Tailscale's range) is not the home address: use the first en0..en9 that has one.
    case "$iface" in
        utun*) addr="" ;;
    esac
    if [ -n "$addr" ] && mm_is_tailscale_address "$addr"; then
        addr=""
    fi
    if [ -z "$addr" ] && [ -n "$iface" ]; then
        n=0
        while [ "$n" -le 9 ]; do
            addr=$(ipconfig getifaddr "en$n" 2>/dev/null)
            if [ -n "$addr" ]; then
                iface="en$n"
                break
            fi
            n=$((n + 1))
        done
    fi

    if [ -n "$addr" ]; then
        mask=$(ipconfig getoption "$iface" subnet_mask 2>/dev/null)
        prefix=$(mm_mask_to_prefix "$mask")
        if [ -z "$prefix" ]; then
            # A fixed address has no DHCP option: read the mask from ifconfig instead.
            line=$(ifconfig "$iface" 2>/dev/null | awk '/^[ \t]*inet / { for (i = 1; i < NF; i++) if ($i == "netmask") { print $(i + 1); exit } }')
            prefix=$(mm_hexmask_to_prefix "$line")
        fi
    fi

    localname=$(scutil --get LocalHostName 2>/dev/null)
    if [ -n "$localname" ]; then localname="$localname.local"; fi

    printf 'home\t%s\t%s\t%s\n' "$(mm_clean "$addr")" "$prefix" "$(mm_clean "$localname")"
}

mm_battery_record() {
    local text present=absent source=ac pct="-" first
    text=$(pmset -g batt 2>/dev/null)
    first=$(printf '%s\n' "$text" | head -n 1)
    case "$first" in
        *"'Battery Power'"*) source=battery ;;
    esac
    case "$text" in
        *InternalBattery*)
            present=present
            pct=$(printf '%s\n' "$text" | sed -n 's/.*[^0-9]\([0-9][0-9]*\)%.*/\1/p' | head -n 1)
            [ -n "$pct" ] || pct="-"
            ;;
    esac
    printf 'battery\t%s\t%s\t%s\n' "$present" "$source" "$pct"
}

mm_tool_record() {
    # $1 name, $2 path or empty, $3 version or empty
    printf 'tool\t%s\t%s\t%s\n' "$1" "${2:--}" "${3:--}"
}

mm_tool_records() {
    local path version

    path=$(command -v brew 2>/dev/null)
    mm_tool_record brew "$path" ""

    path=$(command -v mosh-server 2>/dev/null)
    version=""
    if [ -n "$path" ]; then
        version=$(mosh-server --version 2>&1 | sed -n 's/.*(mosh \([^)]*\)).*/\1/p' | head -n 1)
    fi
    mm_tool_record mosh-server "$path" "$version"

    path=$(command -v tmux 2>/dev/null)
    version=""
    if [ -n "$path" ]; then
        version=$(tmux -V 2>/dev/null | awk '{ print $2; exit }')
    fi
    mm_tool_record tmux "$path" "$version"
}

# The windows of one desk. A window name can hold odd characters; a line that does not start with
# "index|" is the rest of the previous name.
mm_window_records() {
    local desk="$1" text
    text=$(mm_tmux list-windows -t "=$desk:" -F '#{window_index}|#{window_name}' 2>/dev/null)
    printf '%s\n' "$text" | {
        local line prev=""
        while IFS= read -r line; do
            case "$line" in
                [0-9]*"|"*)
                    if [ -n "$prev" ]; then
                        printf 'window\t%s\t%s\t%s\n' "$desk" "${prev%%|*}" "$(mm_clean "${prev#*|}")"
                    fi
                    prev="$line"
                    ;;
                *) prev="$prev $line" ;;
            esac
        done
        if [ -n "$prev" ]; then
            printf 'window\t%s\t%s\t%s\n' "$desk" "${prev%%|*}" "$(mm_clean "${prev#*|}")"
        fi
    }
}

mm_desk_records() {
    local text line name rest windows attached
    mm_server_up || return 0
    # Format: name|windows|attached. A name that breaks the naming rule is left out.
    text=$(mm_tmux list-sessions -F '#{session_name}|#{session_windows}|#{session_attached}' 2>/dev/null)
    printf '%s\n' "$text" | while IFS= read -r line; do
        attached="${line##*|}"
        rest="${line%|*}"
        windows="${rest##*|}"
        name="${rest%|*}"
        mm_valid_desk_name "$name" || continue
        case "$windows$attached" in
            '' | *[!0-9]*) continue ;;
        esac
        printf 'desk\t%s\t%s\t%s\n' "$name" "$windows" "$attached"
        mm_window_records "$name"
    done
}

mm_def_records() {
    local file="$MACMOSH_HOME/desks.tsv" line name
    [ -f "$file" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        name="${line%%"$TAB"*}"
        mm_valid_desk_name "$name" || continue
        printf 'def\t%s\n' "$line"
    done < "$file"
}

cmd_status() {
    local os_version arch console server signins fv ar custom firewall_text sharing_line sharing agent_file
    os_version=$(sw_vers -productVersion 2>/dev/null)
    arch=$(uname -m 2>/dev/null)

    if mm_server_up; then
        server=up
        # shellcheck disable=SC2016  # the command is expanded by the desk server's shell, not here
        signins=$(mm_tmux run-shell 'security show-keychain-info "$HOME/Library/Keychains/login.keychain-db" >/dev/null 2>&1 && echo ok || echo off' 2>/dev/null | head -n 1)
        case "$signins" in
            ok | off) ;;
            *) signins=unknown ;;
        esac
    else
        server=down
        signins=unknown
    fi

    case "$(fdesetup status 2>/dev/null | head -n 1)" in
        "FileVault is On"*) fv=on ;;
        "FileVault is Off"*) fv=off ;;
        *) fv=unknown ;;
    esac
    case "$(fdesetup supportsauthrestart 2>/dev/null | head -n 1)" in
        true) ar=yes ;;
        false) ar=no ;;
        *) ar=unknown ;;
    esac

    custom=$(pmset -g custom 2>/dev/null)

    firewall_text=$(/usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate 2>/dev/null | head -n 1)
    case "$firewall_text" in
        *disabled*) firewall=off ;;
        *enabled*) firewall=on ;;
        *) firewall=unknown ;;
    esac

    sharing_line=$(launchctl print-disabled system 2>/dev/null | grep '"com.apple.screensharing"' | head -n 1)
    case "$sharing_line" in
        *"=> enabled"*) sharing=on ;;
        *"=> disabled"*) sharing=off ;;
        *) sharing=unknown ;;
    esac

    agent_file="$HOME/Library/LaunchAgents/$AGENT_LABEL.plist"

    {
        printf 'macmosh-host\t%s\t%s\n' "$MACMOSH_PROTOCOL" "$MACMOSH_HOST_VERSION"
        printf 'os\t%s\t%s\n' "$(mm_clean "$os_version")" "$(mm_clean "$arch")"
        console=$(mm_console_user)
        printf 'console\t%s\n' "$(mm_clean "$console")"
        printf 'server\t%s\n' "$server"
        printf 'signins\t%s\n' "$signins"
        printf 'filevault\t%s\n' "$fv"
        printf 'authrestart\t%s\n' "$ar"
        printf 'power\tsleep=%s\twomp=%s\tautorestart=%s\tdisablesleep=%s\n' \
            "$(mm_power_value sleep "$custom")" "$(mm_power_value womp "$custom")" \
            "$(mm_power_value autorestart "$custom")" "$(mm_power_value disablesleep "$custom")"
        mm_battery_record
        mm_home_record
        printf 'firewall\t%s\n' "$firewall"
        printf 'screensharing\t%s\n' "$sharing"
        if [ -f "$agent_file" ]; then
            printf 'agent\tinstalled\n'
        else
            printf 'agent\tmissing\n'
        fi
        mm_tool_records
        mm_desk_records
        mm_def_records
        printf 'end\n'
    }
    mm_log status "ok"
    return 0
}

# ---------------------------------------------------------------- main

usage() {
    cat >&2 <<EOF
usage: macmosh-host <subcommand>
  version   print the script version
  start     start the desk server if it is down
  status    print the status report
  attach [--cc] [--dry-run] <desk>
  desk-new <name> <folder> [--reopen] [--keep] [--command <text>]
  desk-remove <name> [--kill]
  keep <desk>   run the desk's startup command again each time it ends
  window-new <desk>
  folders <folder>
  install-agent
  restart-server --yes
  uninstall --key <base64 key>
EOF
}

main() {
    local sub="${1:-}"
    case "$sub" in
        version)
            echo "$MACMOSH_HOST_VERSION"
            mm_log version "ok"
            ;;
        start)
            cmd_start
            ;;
        status)
            cmd_status
            ;;
        attach)
            shift
            cmd_attach "$@"
            ;;
        desk-new)
            shift
            cmd_desk_new "$@"
            ;;
        desk-remove)
            shift
            cmd_desk_remove "$@"
            ;;
        window-new)
            shift
            cmd_window_new "$@"
            ;;
        keep)
            shift
            cmd_keep "$@"
            ;;
        folders)
            shift
            cmd_folders "$@"
            ;;
        restart-server)
            shift
            cmd_restart_server "$@"
            ;;
        uninstall)
            shift
            cmd_uninstall "$@"
            ;;
        install-agent)
            cmd_install_agent
            ;;
        *)
            usage
            mm_log "${sub:-none}" "usage error"
            return 2
            ;;
    esac
}

main "$@"
